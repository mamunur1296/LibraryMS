# Database
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=LibraryMS;Username=postgres;Password=your_db_password

# Authentication
JwtSettings__SecretKey=YourSuperSecretKeyWithAtLeast256BitsOfEntropy!
JwtSettings__Issuer=LibraryMS
JwtSettings__Audience=LibraryMSUsers

# Redis Caching
Redis__Configuration=localhost:6380,abortConnect=false

# SMTP Config (Mailtrap)
Smtp__Host=smtp.mailtrap.io
Smtp__Port=587
Smtp__Username=your_mailtrap_username
Smtp__Password=your_mailtrap_password
Smtp__FromEmail=noreply@libraryms.com
Smtp__FromName=LibraryMS
Smtp__EnableSsl=true
